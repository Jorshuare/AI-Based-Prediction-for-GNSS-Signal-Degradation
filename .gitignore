._*
Thumbs.db
desktop.ini

# ─── Raw data ─────────────────
data/raw/
data/rinex/

# ─── Processed outputs — CSV feature files ARE pushed; nothing else ─────────────
# Block everything by default, then re-allow folders and CSVs.
data/processed/**
!data/processed/
!data/processed/**/
!data/processed/**/*.csv

data/labelled/**
!data/labelled/
!data/labelled/*.csv

# ─── Folder placeholders and docs ────────────────────────────────────────────────
!data/**/README.md
!data/**/README.txt
!data/**/.gitkeep
!data/README.md

# ─── Banks (archive/scratch) — never push ─────────────────────────────────────
banks/
josh_processed_data
runs/
.tmp/
