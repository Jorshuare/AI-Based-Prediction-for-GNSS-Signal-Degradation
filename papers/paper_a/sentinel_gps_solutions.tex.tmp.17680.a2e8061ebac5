\title[SENTINEL: Predictive GNSS Degradation Classification]{%
  SENTINEL: A Transformer--Long Short-Term Memory Framework for Predictive
  Global Navigation Satellite System Signal Degradation Classification
  in Urban Environments}

\author*[1]{\fnm{First} \sur{Author}}\email{author1@buaa.edu.cn}
